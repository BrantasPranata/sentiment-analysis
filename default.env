# =====================================================================
# Konfigurasi LOKAL (testing) untuk backend, frontend & pipeline.
#   docker compose --env-file default.env up -d --build
# Untuk produksi pakai .env.prod (salin dari .env.prod.example).
# =====================================================================

# Service opsional: kosong = hanya frontend + backend; "pipeline" = ikut jalankan scraper/sentimen
COMPOSE_PROFILES=

# --- Database: MariaDB XAMPP lokal (berisi salinan produksi, lihat README) ---
# DB_HOST: alamat dari komputer host (php artisan serve / python langsung)
DB_HOST=127.0.0.1
# DOCKER_DB_HOST: alamat yang sama dilihat dari dalam container
DOCKER_DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_sentimenanalisis_v2
DB_USERNAME=root
DB_PASSWORD=

# --- Backend (Laravel) ---
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:1gVVBxozW7n076gMdXRZAYrZeWDWR+J+TxkxeR8jozE=

# --- Frontend ---
APP_URL=http://localhost:8000
FRONTEND_PORT=8000

# --- Pipeline ---
PIPELINE_INTERVAL_MINUTES=60
HF_TOKEN=

# --- Image ---
IMAGE_PREFIX=sentiment-analysis
IMAGE_TAG=latest
