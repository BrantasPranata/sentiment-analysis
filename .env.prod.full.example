# =====================================================================
# Konfigurasi PRODUKSI LENGKAP (frontend + backend + pipeline di server GPU).
# Salin ke .env.prod (RAHASIA, jangan di-commit), lalu:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.gpu.yml up -d --build
# Server tanpa GPU: hilangkan "-f docker-compose.gpu.yml" (pipeline berjalan di CPU).
# =====================================================================

# Ketiga service dijalankan
COMPOSE_PROFILES=pipeline

# --- Database (dipakai backend & pipeline) ---
DB_HOST=192.0.2.10
DB_PORT=3306
DB_DATABASE=db_sentimenanalisis_v2
DB_USERNAME=
DB_PASSWORD=

# --- Backend (Laravel) ---
APP_ENV=production
APP_DEBUG=false
# Buat: docker run --rm php:8.5-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# --- Frontend ---
APP_URL=https://dashboard.example.com/sentiment-analysis
FRONTEND_PORT=8000
# Nama network Docker milik nginx reverse proxy (docker-compose.prod.yml)
PROXY_NETWORK=

# --- Pipeline ---
PIPELINE_INTERVAL_MINUTES=60
HF_TOKEN=

# --- Image (diisi otomatis oleh CI) ---
IMAGE_PREFIX=sentiment-analysis
IMAGE_TAG=latest

# --- Server GPU (docker-compose.gpu.yml) ---
# Index PyTorch sesuai versi CUDA server
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
